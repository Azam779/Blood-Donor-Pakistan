rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBloodGroup(bg) {
      return bg in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function isValidPakistaniPhone(phone) {
      return phone is string && phone.size() >= 10 && phone.size() <= 15;
    }

    function isValidDonor(data) {
      return data.keys().hasAll(['uid', 'name', 'phone', 'age', 'bloodGroup', 'province', 'district', 'city', 'available', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && isValidPakistaniPhone(data.phone)
        && data.age is int && data.age >= 18 && data.age <= 65
        && isValidBloodGroup(data.bloodGroup)
        && data.province is string && data.province.size() > 0 && data.province.size() <= 50
        && data.district is string && data.district.size() > 0 && data.district.size() <= 50
        && data.city is string && data.city.size() > 0 && data.city.size() <= 50
        && (!('area' in data) || (data.area is string && data.area.size() <= 100))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && data.available is bool
        && (!('role' in data) || data.role in ['user', 'admin'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Donors Collection Rules
    match /donors/{donorId} {
      // 1. Read single document:
      // Allow if donor is active/available OR if the request is from the owner/admin
      allow get: if resource.data.available == true || (isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()));

      // 2. List/Query donors:
      // Allow searching for available donors, or owners querying their own record
      allow list: if resource.data.available == true || (isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()));

      // 3. Create donor record:
      // Must be authenticated, donorId matching their UID (or document uid matches auth uid), valid payload, role default to user
      allow create: if isSignedIn()
        && isValidId(donorId)
        && request.resource.data.uid == request.auth.uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && isValidDonor(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 4. Update donor record:
      // Only the profile owner or admin can update, UID and createdAt must remain immutable
      allow update: if (isOwner(resource.data.uid) || isAdmin())
        && isValidDonor(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        // User cannot escalate themselves to admin
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin());

      // 5. Delete donor record:
      // Only the profile owner or admin can delete
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // Admin authorization collection (read-only for authenticated users, protected writes)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via Firebase Console or Backend only
    }
  }
}
